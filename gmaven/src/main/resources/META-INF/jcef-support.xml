<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="ru.rzn.gmyasoedov.gmaven.central.PomWebMavenCentralEditorProvider"/>
    </extensions>

    <actions>
        <action id="GMaven.MavenCentralBrowserAction"
                class="ru.rzn.gmyasoedov.gmaven.project.action.MavenCentralBrowserAction">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>